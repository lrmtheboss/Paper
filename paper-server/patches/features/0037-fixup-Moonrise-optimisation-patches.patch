Subject: [PATCH] fixup! Moonrise optimisation patches


diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index 3ed912fb19e1dfda7987fcf4b504aff5abccc46c..fd0b9f20fbdd523d51550fd6009b5011e6e7e6e6 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1045,6 +1045,40 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
         // Paper end - optimise entity tracker
     }
 
+    // Paper start - rewrite chunk system
+    @Override
+    public net.minecraft.world.level.chunk.storage.ChunkScanAccess chunkScanner() {
+        return (chunkPos, streamTagVisitor) -> {
+            final CompletableFuture<Void> ret = new CompletableFuture<>();
+
+            ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO.loadDataAsync(
+                ChunkMap.this.level, chunkPos.x(), chunkPos.z(), ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO.RegionFileType.CHUNK_DATA,
+                (java.util.function.BiConsumer<net.minecraft.nbt.CompoundTag, Throwable> & ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO.NoCopyNBTData) (final CompoundTag data, final Throwable thr) -> {
+                    if (thr != null) {
+                        ret.completeExceptionally(thr);
+                        return;
+                    }
+
+                    if (data == null) {
+                        ret.complete(null);
+                        return;
+                    }
+
+                    try {
+                        data.acceptAsRoot(streamTagVisitor);
+
+                        ret.complete(null);
+                    } catch (final Throwable thr2) {
+                        ret.completeExceptionally(thr2);
+                        LOGGER.error("Error while scanning chunk " + chunkPos + " in world '" + ca.spottedleaf.moonrise.common.util.WorldUtil.getWorldName(ChunkMap.this.level) + "':", thr2);
+                    }
+                }, false
+            );
+
+            return ret;
+        };
+    }
+    // Paper end - rewrite chunk system
     // Paper start - optimise entity tracker
     private static final Entity[] EMPTY_ENTITY_ARRAY = new Entity[0];
     private ca.spottedleaf.moonrise.common.list.ReferenceList<net.minecraft.world.entity.Entity> trackerEntities = new ca.spottedleaf.moonrise.common.list.ReferenceList<>(EMPTY_ENTITY_ARRAY);
